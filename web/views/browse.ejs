<%
  function qs(overrides) {
    var p = Object.assign({}, query, overrides);
    return lp + '/browse?' + Object.keys(p)
      .filter(function (k) { return p[k] != null && p[k] !== ''; })
      .map(function (k) { return k + '=' + encodeURIComponent(p[k]); })
      .join('&');
  }
  var FORMATIONS = [
    ['', t('browse.formation_any')],
    ['pictographic-or-simple', t('browse.formation_pictographic')],
    ['compound-ideographic', t('browse.formation_compound')],
    ['phono-semantic', t('browse.formation_phono')],
    ['unknown', t('browse.formation_uncertain')],
  ];
%>
<%- include('partials/head', { pageClass: 'page-browse' }) %>

<h1 class="results-heading"><%= t('browse.heading', { count: meta.kanji_count }) %></h1>

<form class="browse-filters" method="get" action="<%= lp %>/browse">
  <label><%= t('browse.filter_grade') %>
    <select name="grade">
      <option value=""><%= t('browse.any') %></option>
      <% [1,2,3,4,5,6,8].forEach(function (g) { %>
        <option value="<%= g %>" <%= filters.grade === g ? 'selected' : '' %>><%= g === 8 ? t('browse.grade_secondary') : t('browse.grade_n', { n: g }) %></option>
      <% }) %>
    </select>
  </label>
  <label><%= t('browse.filter_jlpt') %>
    <select name="jlpt">
      <option value=""><%= t('browse.any') %></option>
      <% [1,2,3,4].forEach(function (j) { %>
        <option value="<%= j %>" <%= filters.jlpt === j ? 'selected' : '' %>><%= t('browse.jlpt_level', { n: j }) %></option>
      <% }) %>
    </select>
  </label>
  <label><%= t('browse.filter_strokes') %>
    <select name="strokes">
      <option value=""><%= t('browse.any') %></option>
      <% strokeCounts.forEach(function (s) { %>
        <option value="<%= s %>" <%= filters.strokes === s ? 'selected' : '' %>><%= s %></option>
      <% }) %>
    </select>
  </label>
  <label><%= t('browse.filter_type') %>
    <select name="formation">
      <% FORMATIONS.forEach(function (f) { %>
        <option value="<%= f[0] %>" <%= filters.formation === f[0] ? 'selected' : '' %>><%= f[1] %></option>
      <% }) %>
    </select>
  </label>
  <label><%= t('browse.filter_sort') %>
    <select name="sort">
      <option value="freq" <%= filters.sort === 'freq' ? 'selected' : '' %>><%= t('browse.sort_freq') %></option>
      <option value="strokes" <%= filters.sort === 'strokes' ? 'selected' : '' %>><%= t('browse.sort_strokes') %></option>
      <option value="radical" <%= filters.sort === 'radical' ? 'selected' : '' %>><%= t('browse.sort_radical') %></option>
    </select>
  </label>
  <button type="submit"><%= t('browse.apply') %></button>
  <a class="browse-reset" href="<%= lp %>/browse"><%= t('browse.reset') %></a>
</form>

<p class="count">
  <%= total ? t('browse.count_paged', { count: total.toLocaleString('en-US'), page: page, pages: pages })
            : t('browse.count', { count: total.toLocaleString('en-US') }) %>.
  <a href="<%= lp %>/radicals"><%= t('browse.search_radical') %> &rarr;</a>
</p>

<% if (!results.length) { %>
  <p class="empty"><%= t('browse.no_match') %></p>
<% } else { %>
  <ul class="result-grid">
    <% results.forEach(function (r) { %>
      <li>
        <a href="<%= lp %>/kanji/<%= encodeURIComponent(r.literal) %>">
          <span class="glyph"><%= r.literal %></span>
          <span class="gloss"><%= r.meaning %></span>
        </a>
      </li>
    <% }) %>
  </ul>

  <% if (pages > 1) { %>
    <nav class="pager">
      <% if (page > 1) { %><a href="<%= qs({ page: page - 1 }) %>">&larr; <%= t('browse.prev') %></a><% } else { %><span>&larr; <%= t('browse.prev') %></span><% } %>
      <span class="pager-mid"><%= t('browse.page_of', { page: page, pages: pages }) %></span>
      <% if (page < pages) { %><a href="<%= qs({ page: page + 1 }) %>"><%= t('browse.next') %> &rarr;</a><% } else { %><span><%= t('browse.next') %> &rarr;</span><% } %>
    </nav>
  <% } %>
<% } %>

<%- include('partials/foot', { pageClass: 'page-browse' }) %>
