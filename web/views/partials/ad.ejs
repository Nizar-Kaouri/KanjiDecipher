<%
  // Placeholder ad slot. No ad network wired up — this just reserves the space
  // and gives it a stable hook (data-ad-slot) for later. See README "Ads".
  var _slot = (typeof slot !== 'undefined') ? slot : 'generic';
  var _size = (typeof size !== 'undefined') ? size : 'leaderboard';
%>
<aside class="ad-slot ad-<%= _size %>" data-ad-slot="<%= _slot %>" role="complementary" aria-label="Advertisement">
  <span class="ad-tag">Advertisement</span>
  <span class="ad-note">Ad space — <%= _slot %></span>
</aside>
