<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' · Kanji Origin' : 'Kanji Origin' %></title>
  <meta name="description" content="Look up any jōyō kanji: components, meanings, readings, stroke order, and a plain-language origin story.">
  <script>
    // Apply a saved theme before first paint (no flash).
    (function () {
      try {
        var t = localStorage.getItem("theme");
        if (t === "dark" || t === "light") document.documentElement.setAttribute("data-theme", t);
      } catch (e) {}
    })();
  </script>
  <link rel="stylesheet" href="/styles.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>字</text></svg>">
</head>
<body class="<%= typeof pageClass !== 'undefined' ? pageClass : '' %>">
<header class="site-header">
  <a class="brand" href="/">字 <span>Kanji Origin</span></a>
  <nav class="site-nav">
    <a href="/browse">Browse</a>
    <a href="/radicals">Radicals</a>
  </nav>
  <form class="search" action="/search" method="get" role="search" autocomplete="off">
    <input type="search" name="q" id="q" placeholder="kanji, meaning, or reading…"
           value="<%= typeof search !== 'undefined' ? search.query : '' %>"
           aria-label="Search">
    <button type="submit">Search</button>
  </form>
  <button type="button" class="theme-toggle" aria-label="Toggle colour theme">
    <svg class="ti ti-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/>
    </svg>
    <svg class="ti ti-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4"/>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
    </svg>
    <svg class="ti ti-dark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
    </svg>
  </button>
</header>
<%
  var _sideRails = (typeof pageClass !== 'undefined') &&
    (pageClass === 'page-home' || pageClass === 'page-kanji');
  var _railBase = pageClass === 'page-home' ? 'home' : 'kanji';
%>
<div class="page-shell<%= _sideRails ? ' has-rails' : '' %>">
  <% if (_sideRails) { %>
    <div class="page-rail page-rail-left" aria-hidden="true">
      <%- include('ad', { slot: _railBase + '-left', size: 'skyscraper' }) %>
    </div>
  <% } %>
  <main class="wrap">
