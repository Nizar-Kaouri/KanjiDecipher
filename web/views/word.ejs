<%- include('partials/head', { pageClass: 'page-word' }) %>

<article class="word-detail">

  <header class="wd-head">
    <h1 class="wd-word" lang="ja"><%= word %></h1>

    <% if (isExact) { %>
      <div class="wd-readings">
        <% entries.forEach(function (e) { %>
          <p class="wd-entry">
            <span class="wd-reading kana"><%= e.reading %></span>
            <span class="wd-gloss"><%= e.gloss %></span>
          </p>
        <% }) %>
      </div>
    <% } else { %>
      <p class="wd-note note"><%= t('word.not_in_dict') %></p>
    <% } %>
  </header>

  <% if (typeof origin !== 'undefined' && origin) { %>
    <section class="kd-block wd-origin">
      <h2><%= t('word.origin') %></h2>
      <p class="origin-text"><%- linkifyKanji(origin.note) %></p>
      <% if (origin.isFallback) { %>
        <p class="origin-tag muted"><%= t('word.origin_fallback_note', { lang: langLabel }) %></p>
      <% } %>
    </section>
  <% } %>

  <% if (breakdown.length) { %>
    <section class="kd-block wd-breakdown-block">
      <h2><%= isExact ? t('word.breakdown') : t('word.what_each_means') %></h2>
      <ul class="kanji-chips wd-breakdown">
        <% breakdown.forEach(function (k) { %><%- include('partials/kanji-chip', { k: k }) %><% }) %>
      </ul>
      <p class="wd-hint muted"><%= t('word.each_links_note') %></p>
    </section>
  <% } %>

</article>

<%- include('partials/foot', { pageClass: 'page-word' }) %>
