<%- include('partials/head', { pageClass: 'page-radicals' }) %>

<h1 class="results-heading"><%= t('radicals.heading') %></h1>

<% if (!groups) { %>
  <p class="note"><%- t('radicals.need_data_html') %></p>
<% } else { %>
  <p class="count">
    <%- t('radicals.pick_note_html') %>
    <a href="<%= lp %>/browse"><%= t('radicals.browse_link') %> &rarr;</a>
  </p>

  <div class="rad-selected" id="rad-selected" hidden>
    <span><%= t('radicals.selected') %></span>
    <span id="rad-selected-list"></span>
    <button type="button" id="rad-clear"><%= t('radicals.clear') %></button>
  </div>

  <div class="rad-grid" data-lang="<%= lang %>" data-lp="<%= lp %>"
       data-s-begin="<%= t('radicals.select_to_begin') %>"
       data-s-searching="<%= t('radicals.searching') %>"
       data-s-matches="<%= t('radicals.matches') %>"
       data-s-matches-capped="<%= t('radicals.matches_capped') %>"
       data-s-none="<%= t('radicals.none') %>">
    <% groups.forEach(function (g) { %>
      <div class="rad-group">
        <span class="rad-strokes"><%= g.strokes != null ? g.strokes : '?' %></span>
        <div class="rad-parts">
          <% g.parts.forEach(function (p) { %>
            <button type="button" class="rad-btn" data-part="<%= p.part %>" title="<%= t('radicals.btn_title', { n: p.count }) %>"><%= p.display %></button>
          <% }) %>
        </div>
      </div>
    <% }) %>
  </div>

  <div class="rad-results-wrap">
    <p class="count" id="rad-count"><%= t('radicals.select_to_begin') %></p>
    <ul class="result-grid" id="rad-results"></ul>
  </div>
<% } %>

<%- include('partials/foot', { pageClass: 'page-radicals' }) %>
