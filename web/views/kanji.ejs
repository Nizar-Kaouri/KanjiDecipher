<%
  function gradeLabel(g) {
    if (g >= 1 && g <= 6) return t('grade.kyoiku', { n: g });
    if (g === 8) return t('grade.secondary');
    return t('grade.plain', { n: g });
  }
  function chipRow(label, items) { %>
    <div class="related-row">
      <span class="related-label"><%- label %></span>
      <ul class="kanji-chips">
        <% items.forEach(function (k) { %><%- include('partials/kanji-chip', { k: k }) %><% }) %>
      </ul>
    </div>
<% }

  // "Same sound component 青" — link each phonetic element to its series page.
  function sameSoundLabel() {
    var parts = kanji.samePhoneticLabels.map(function (p) {
      return kanji.samePhoneticLinkable.indexOf(p) >= 0
        ? '<a class="kref" href="' + lp + '/sound/' + encodeURIComponent(p) + '">' + p + '</a>'
        : p;
    }).join(' ');
    return t('kanji.same_sound', { parts: parts });
  }
%>
<%- include('partials/head', { pageClass: 'page-kanji' }) %>

<article class="kanji-detail" data-literal="<%= kanji.literal %>">

  <div class="kd-hero">
    <div class="kd-info">
      <section class="kd-meanings">
        <h2><%= t('kanji.meaning_readings') %></h2>
        <p class="meanings"><%= kanji.meanings.join(', ') || t('kanji.meanings_dash') %></p>
        <div class="readings">
          <% if (kanji.on_readings.length) { %>
            <div><span class="rlabel"><%= t('kanji.onyomi') %></span> <span class="kana"><%= kanji.on_readings.join('、') %></span></div>
          <% } %>
          <% if (kanji.kun_readings.length) { %>
            <div><span class="rlabel"><%= t('kanji.kunyomi') %></span> <span class="kana"><%= kanji.kun_readings.join('、') %></span></div>
          <% } %>
          <% if (kanji.nanori.length) { %>
            <div><span class="rlabel"><%= t('kanji.nanori') %></span> <span class="kana muted"><%= kanji.nanori.join('、') %></span></div>
          <% } %>
        </div>
      </section>

      <section class="kd-origin">
        <h2><%= t('kanji.origin') %></h2>
        <% if (kanji.origin_story) { %>
          <p class="origin-text"><%- linkifyKanji(kanji.origin_story) %></p>
          <% if (kanji.originIsFallback) { %>
            <p class="origin-tag muted"><%= t('kanji.origin_fallback_note', { lang: langLabel }) %></p>
          <% } %>
        <% } else { %>
          <p class="origin-text muted"><%= t('kanji.no_story') %></p>
        <% } %>
      </section>
    </div>

    <div class="kd-visual">
      <figure class="kanji-card">
        <div class="stroke-view" id="stroke-view" data-mode="anim">
          <div class="sv-anim"><%- kanji.svg %></div>
          <div class="sv-static" hidden><%- kanji.svg_static %></div>
        </div>
        <div class="stroke-controls">
          <button type="button" data-act="play">&#9654;&nbsp;<%= t('kanji.stroke_play') %></button>
          <button type="button" data-act="step"><%= t('kanji.stroke_step') %></button>
          <button type="button" data-act="reset"><%= t('kanji.stroke_reset') %></button>
          <button type="button" data-act="toggle"><%= t('kanji.stroke_numbered') %></button>
        </div>
        <figcaption class="kanji-card-cap">
          <span class="cc-char"><%= kanji.literal %></span>
          <span class="cc-count"><%= t('kanji.strokes_count', { n: kanji.stroke_count }) %></span>
        </figcaption>
      </figure>

      <section class="kd-components">
        <h2><%= t('kanji.components') %></h2>
        <% if (kanji.components.length <= 1) { %>
          <p class="note"><%= t('kanji.single_shape', { paren: kanji.components.length ? ' (' + kanji.components[0].element + ')' : '' }) %></p>
        <% } %>
        <ul class="component-list">
          <% kanji.components.forEach(function (c, i) { %>
            <li class="component role-<%= c.roleKey %>" data-component="<%= i %>">
              <span class="c-glyph"><%- linkifyKanji(c.element) %></span>
              <span class="c-meta">
                <span class="c-role"><%= t('role.' + c.roleKey) %></span>
                <% if (c.position) { %><span class="c-pos"><%= t('position.' + c.position) %></span><% } %>
              </span>
            </li>
          <% }) %>
        </ul>
        <% if (kanji.components.some(function (c) { return c.isPhonetic; })) { %>
          <p class="phon-note"><%- t('kanji.sound_hint_note_html') %></p>
        <% } %>
      </section>
    </div>
  </div>

  <% if (kanji.exampleWords && kanji.exampleWords.length) { %>
    <section class="kd-block kd-words">
      <h2><%= t('kanji.common_words') %></h2>
      <ul class="word-list">
        <% kanji.exampleWords.forEach(function (w) { %>
          <li>
            <a class="wl-word" href="<%= lp %>/word/<%= encodeURIComponent(w.word) %>" lang="ja"><%= w.word %></a>
            <span class="wl-reading kana"><%= w.reading %></span>
            <span class="wl-gloss"><%= w.gloss %></span>
          </li>
        <% }) %>
      </ul>
    </section>
  <% } %>

  <%
    var relRows = [];
    if (kanji.samePhonetic && kanji.samePhonetic.length)
      relRows.push([sameSoundLabel(), kanji.samePhonetic]);
    if (kanji.sameRadical && kanji.sameRadical.length)
      relRows.push([t('kanji.same_radical'), kanji.sameRadical]);
    if (kanji.sharesComponents && kanji.sharesComponents.length)
      relRows.push([t('kanji.shares_components'), kanji.sharesComponents]);
  %>
  <% if (relRows.length) { %>
    <section class="kd-block kd-related">
      <h2><%= t('kanji.related') %></h2>
      <% relRows.forEach(function (r) { chipRow(r[0], r[1]); }) %>
    </section>
  <% } %>

  <% if (kanji.confusable && kanji.confusable.length) { %>
    <section class="kd-block kd-confusable">
      <h2><%= t('kanji.confusable') %></h2>
      <p class="note"><%= t('kanji.confusable_note') %></p>
      <ul class="kanji-chips">
        <% kanji.confusable.forEach(function (k) { %><%- include('partials/kanji-chip', { k: k }) %><% }) %>
      </ul>
    </section>
  <% } %>

  <section class="kd-block kd-facts">
    <h2><%= t('kanji.reference') %></h2>
    <dl>
      <div><dt><%= t('kanji.ref_strokes') %></dt><dd><%= kanji.stroke_count ?? t('kanji.meanings_dash') %></dd></div>
      <div><dt><%= t('kanji.ref_kangxi') %></dt><dd><%= kanji.radical_number ?? t('kanji.meanings_dash') %></dd></div>
      <div><dt><%= t('kanji.ref_formation') %></dt><dd><%= kanji.formation_type ? t('formation.' + kanji.formation_type) : t('kanji.meanings_dash') %></dd></div>
      <div><dt><%= t('kanji.ref_grade') %></dt><dd><%= kanji.grade ? gradeLabel(kanji.grade) : t('kanji.meanings_dash') %></dd></div>
      <div><dt><%= t('kanji.ref_freq') %></dt><dd><%= kanji.freq ? t('kanji.ref_freq_value', { n: kanji.freq }) : t('kanji.meanings_dash') %></dd></div>
      <div><dt><%= t('kanji.ref_jlpt') %></dt><dd><%= kanji.jlpt ? t('kanji.ref_jlpt_value', { n: kanji.jlpt }) : t('kanji.meanings_dash') %></dd></div>
      <div><dt><%= t('kanji.ref_unicode') %></dt><dd><%= kanji.codepoint ?? t('kanji.meanings_dash') %></dd></div>
    </dl>
  </section>

</article>

<%- include('partials/foot', { pageClass: 'page-kanji' }) %>
