<%
  function gradeLabel(g) {
    if (g >= 1 && g <= 6) return 'Grade ' + g + ' (Kyōiku)';
    if (g === 8) return 'Jōyō (secondary school)';
    return 'Grade ' + g;
  }
  function chipRow(label, items) { %>
    <div class="related-row">
      <span class="related-label"><%= label %></span>
      <ul class="kanji-chips">
        <% items.forEach(function (k) { %>
          <li><a href="/kanji/<%= encodeURIComponent(k.literal) %>">
            <span class="kc-glyph"><%= k.literal %></span>
            <span class="kc-gloss"><%= k.meaning %></span>
          </a></li>
        <% }) %>
      </ul>
    </div>
<% }
%>
<%- include('partials/head', { pageClass: 'page-kanji' }) %>

<article class="kanji-detail" data-literal="<%= kanji.literal %>">

  <div class="kd-hero">
    <div class="kd-info">
      <section class="kd-meanings">
        <h2>Meaning &amp; readings</h2>
        <p class="meanings"><%= kanji.meanings.join(', ') || '—' %></p>
        <div class="readings">
          <% if (kanji.on_readings.length) { %>
            <div><span class="rlabel">On&rsquo;yomi</span> <span class="kana"><%= kanji.on_readings.join('、') %></span></div>
          <% } %>
          <% if (kanji.kun_readings.length) { %>
            <div><span class="rlabel">Kun&rsquo;yomi</span> <span class="kana"><%= kanji.kun_readings.join('、') %></span></div>
          <% } %>
          <% if (kanji.nanori.length) { %>
            <div><span class="rlabel">Nanori</span> <span class="kana muted"><%= kanji.nanori.join('、') %></span></div>
          <% } %>
        </div>
      </section>

      <section class="kd-origin">
        <h2>Origin</h2>
        <% if (kanji.origin_story) { %>
          <p class="origin-text"><%- linkifyKanji(kanji.origin_story) %></p>
          <p class="origin-tag">
            <% if (kanji.origin_story_model === 'manual-seed') { %>
              Hand-written summary.
            <% } else { %>
              AI-generated (<%= kanji.origin_story_model %>)<%= kanji.origin_story_reviewed ? ', reviewed' : ', not yet reviewed' %>.
            <% } %>
            Formation type (automated guess): <%= kanji.formation_label %>.
          </p>
        <% } else { %>
          <p class="origin-text muted">
            No origin story yet. Run <code>node pipeline/4-generate-origin-stories.js --only <%= kanji.literal %></code>
            to generate one.
          </p>
          <p class="origin-tag">Formation type (automated guess): <%= kanji.formation_label %>.</p>
        <% } %>
      </section>
    </div>

    <div class="kd-visual">
      <figure class="kanji-card">
        <div class="stroke-view" id="stroke-view" data-mode="anim">
          <div class="sv-anim"><%- kanji.svg %></div>
          <div class="sv-static" hidden><%- kanji.svg_static %></div>
        </div>
        <div class="stroke-controls">
          <button type="button" data-act="play">▶&nbsp;Play</button>
          <button type="button" data-act="step">Step</button>
          <button type="button" data-act="reset">Reset</button>
          <button type="button" data-act="toggle">Numbered</button>
        </div>
        <figcaption class="kanji-card-cap">
          <span class="cc-char"><%= kanji.literal %></span>
          <span class="cc-count"><%= kanji.stroke_count %> strokes</span>
        </figcaption>
      </figure>

      <section class="kd-components">
        <h2>Components</h2>
        <% if (kanji.components.length <= 1) { %>
          <p class="note">This character is treated as a single, undivided shape<%= kanji.components.length ? ' (' + kanji.components[0].element + ')' : '' %>.</p>
        <% } %>
        <ul class="component-list">
          <% kanji.components.forEach(function (c, i) { %>
            <li class="component role-<%= c.role.replace(/\s+/g,'-') %>" data-component="<%= i %>">
              <span class="c-glyph"><%- linkifyKanji(c.element) %></span>
              <span class="c-meta">
                <span class="c-role"><%= c.role %></span>
                <% if (c.positionLabel) { %><span class="c-pos"><%= c.positionLabel %></span><% } %>
              </span>
            </li>
          <% }) %>
        </ul>
        <% if (kanji.components.some(c => c.isPhonetic)) { %>
          <p class="phon-note">
            A <strong>sound hint</strong> component points at the character&rsquo;s pronunciation,
            not its meaning — don&rsquo;t read a meaning into it.
          </p>
        <% } %>
      </section>
    </div>
  </div>

  <% if (kanji.exampleWords && kanji.exampleWords.length) { %>
    <section class="kd-block kd-words">
      <h2>Common words</h2>
      <ul class="word-list">
        <% kanji.exampleWords.forEach(function (w) { %>
          <li>
            <span class="wl-word"><%- linkifyKanji(w.word) %></span>
            <span class="wl-reading kana"><%= w.reading %></span>
            <span class="wl-gloss"><%= w.gloss %></span>
          </li>
        <% }) %>
      </ul>
    </section>
  <% } %>

  <%
    var relRows = [];
    if (kanji.samePhonetic && kanji.samePhonetic.length)
      relRows.push(['Same sound component ' + kanji.samePhoneticLabels.join(' '), kanji.samePhonetic]);
    if (kanji.sameRadical && kanji.sameRadical.length)
      relRows.push(['Same radical', kanji.sameRadical]);
    if (kanji.sharesComponents && kanji.sharesComponents.length)
      relRows.push(['Shares components', kanji.sharesComponents]);
  %>
  <% if (relRows.length) { %>
    <section class="kd-block kd-related">
      <h2>Related kanji</h2>
      <% relRows.forEach(function (r) { chipRow(r[0], r[1]); }) %>
    </section>
  <% } %>

  <section class="kd-block kd-facts">
    <h2>Reference</h2>
    <dl>
      <div><dt>Strokes</dt><dd><%= kanji.stroke_count ?? '—' %></dd></div>
      <div><dt>Kangxi radical</dt><dd><%= kanji.radical_number ?? '—' %></dd></div>
      <div><dt>Grade</dt><dd><%= kanji.grade ? gradeLabel(kanji.grade) : '—' %></dd></div>
      <div><dt>Frequency rank</dt><dd><%= kanji.freq ? '#' + kanji.freq + ' (newspapers)' : '—' %></dd></div>
      <div><dt>Former JLPT</dt><dd><%= kanji.jlpt ? 'level ' + kanji.jlpt : '—' %></dd></div>
      <div><dt>Unicode</dt><dd><%= kanji.codepoint ?? '—' %></dd></div>
    </dl>
  </section>

</article>

<%- include('partials/foot', { pageClass: 'page-kanji' }) %>
